            }
          }
        }
      },
      margin: { left: 40, right: 40 }
    });
  } else {
    // Fallback: o PDF continua funcionando mesmo se o plugin AutoTable não carregar.
    let yy = y + 30;
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(8.5);
    doc.text('Itens registrados:', 40, yy);
    yy += 16;
    doc.setFont('helvetica', 'normal');
    rows.forEach((r) => {
      const linha = `${r[0]}. ${r[1]} | ${r[2]} | Val.: ${r[3]} | Qtd: ${r[4]} | ${r[5]}`;
      const linhas = doc.splitTextToSize(linha, pageWidth - 80);
      if(yy + linhas.length * 11 > 770){ doc.addPage(); yy = 45; }
      doc.text(linhas, 40, yy);
      yy += linhas.length * 11 + 5;
    });
  }

  const finalY = (doc.lastAutoTable && doc.lastAutoTable.finalY) ? doc.lastAutoTable.finalY + 20 : 760;
  if(finalY > 790){ doc.addPage(); }
  const resumoY = finalY > 790 ? 45 : finalY;
  doc.setTextColor(30,30,30);
  doc.setFontSize(9.5);
  doc.setFont('helvetica', 'bold');
