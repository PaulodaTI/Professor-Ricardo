<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Controle de Validade - Promotor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=Kaushan+Script&display=swap" rel="stylesheet">
<style>
  :root{
    --coke-red:#F40009;
    --coke-red-2:#E00007;
    --coke-red-deep:#8A0000;
    --ink:#1A1414;
    --ink-soft:#4A4040;
    --paper:#FFFFFF;
    --paper-wash:#FFF7F6;
    --line:#EFE6E5;
    --line-strong:#E3D5D4;
    --muted:#8A7B79;
    --success:#0F8A3E;
    --danger:#D6242C;
    --surface:#FBF4F3;
    --shadow-sm:0 2px 10px rgba(26,20,20,.06);
    --shadow-md:0 14px 32px rgba(26,20,20,.10);
    --shadow-red:0 12px 26px rgba(244,0,9,.28);
    --radius-lg:20px;
    --radius-md:14px;
    --radius-sm:10px;
  }

  *{box-sizing:border-box;}

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important;}
  }

  body{
    margin:0;
    font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    background:var(--paper-wash);
    color:var(--ink);
    padding-bottom:104px;
    -webkit-font-smoothing:antialiased;
  }

  :focus-visible{
    outline:2.5px solid var(--coke-red);
    outline-offset:2px;
    border-radius:6px;
  }

  /* ===== HEADER ===== */
  header{
    background:linear-gradient(160deg,var(--coke-red) 0%,var(--coke-red-2) 55%,var(--coke-red-deep) 100%);
    padding:18px 18px 0;
    position:sticky;
    top:0;
    z-index:10;
    box-shadow:0 6px 24px rgba(138,0,0,.28);
    overflow:hidden;
  }
  .header-inner{
    max-width:520px;
    margin:0 auto;
    padding-bottom:14px;
  }
  .brand-mark{
    display:block;
    font-family:'Kaushan Script',cursive;
    font-size:22px;
    color:#fff;
    line-height:1;
    margin-bottom:2px;
    text-shadow:0 2px 6px rgba(0,0,0,.15);
  }
  header h1{
    margin:0;
    font-family:'Barlow Condensed',sans-serif;
    font-weight:800;
    font-size:23px;
    letter-spacing:.4px;
    text-transform:uppercase;
    color:#fff;
    line-height:1.1;
  }
  header p{
    margin:4px 0 0;
    font-size:12.5px;
    color:rgba(255,255,255,.85);
    font-weight:500;
  }
  .ribbon{
    display:block;
    width:200%;
    height:20px;
    animation:ribbon-drift 26s linear infinite;
  }
  .ribbon path{fill:#fff;}
  @keyframes ribbon-drift{
    from{transform:translateX(0);}
    to{transform:translateX(-50%);}
  }

  /* ===== LAYOUT ===== */
  .container{
    padding:16px;
    max-width:520px;
    margin:0 auto;
  }

  .card{
    background:var(--paper);
    border:1px solid var(--line);
    border-radius:var(--radius-lg);
    padding:18px;
    margin-bottom:14px;
    box-shadow:var(--shadow-sm);
  }
  .card h2, .section-title{
    font-family:'Barlow Condensed',sans-serif;
    font-size:13px;
    text-transform:uppercase;
    letter-spacing:1px;
    color:var(--coke-red);
    margin:0 0 12px;
    font-weight:700;
  }

  label{
    display:block;
    font-size:12px;
    font-weight:500;
    color:var(--muted);
    margin-bottom:5px;
    margin-top:12px;
  }
  label:first-of-type{margin-top:0;}

  input[type=text], input[type=date], input[type=number]{
    width:100%;
    background:var(--surface);
    border:1.5px solid var(--line-strong);
    color:var(--ink);
    border-radius:var(--radius-sm);
    padding:12px 13px;
    font-size:15px;
    font-family:'Inter',sans-serif;
    min-height:46px;
    outline:none;
    transition:border-color .15s ease, box-shadow .15s ease;
  }
  input::placeholder{color:#b3a5a3;}
  input:focus{border-color:var(--coke-red);box-shadow:0 0 0 4px rgba(244,0,9,.10);}

  .busca-row{display:flex;gap:8px;}
  .busca-row .autocomplete-wrap{flex:1;}
  .btn-scan{
    background:linear-gradient(135deg,var(--coke-red),var(--coke-red-deep));
    color:#fff;
    padding:0 16px;
    min-height:46px;
    border:none;
    border-radius:var(--radius-sm);
    font-size:20px;
    line-height:1;
    flex-shrink:0;
    box-shadow:var(--shadow-red);
  }
  .btn-scan:active{transform:scale(.96);}

  .autocomplete-wrap{position:relative;}
  .suggestions{
    position:absolute;
    top:calc(100% + 6px);
    left:0;right:0;
    background:var(--paper);
    border:1px solid var(--line);
    border-radius:var(--radius-sm);
    max-height:240px;
    overflow-y:auto;
    z-index:20;
    display:none;
    box-shadow:var(--shadow-md);
  }
  .suggestions div{
    padding:11px 13px;
    font-size:13.5px;
    border-bottom:1px solid var(--line);
    cursor:pointer;
  }
  .suggestions div:last-child{border-bottom:none;}
  .suggestions div:active, .suggestions div.active{background:var(--paper-wash);}
  .suggestions .cod{color:var(--muted);font-size:11px;}

  .selected-box{
    display:none;
    background:var(--paper-wash);
    border:1.5px solid var(--coke-red);
    border-radius:var(--radius-sm);
    padding:11px 13px;
    margin-top:9px;
    font-size:13.5px;
  }
  .selected-box .cod{color:var(--muted);font-size:11.5px;margin-top:2px;}

  .row2{display:flex;gap:10px;}
  .row2>div{flex:1;}

  button{
    border:none;
    border-radius:var(--radius-sm);
    padding:13px 16px;
    font-size:14.5px;
    font-weight:700;
    font-family:'Inter',sans-serif;
    cursor:pointer;
    transition:transform .12s ease, opacity .12s ease;
  }

  .btn-add{
    width:100%;
    background:linear-gradient(135deg,var(--coke-red),var(--coke-red-deep));
    color:#fff;
    margin-top:14px;
    box-shadow:var(--shadow-red);
    font-family:'Barlow Condensed',sans-serif;
    text-transform:uppercase;
    letter-spacing:.5px;
    font-size:15px;
    font-weight:700;
  }
  .btn-add:disabled{background:#e6d9d8;color:#a99998;box-shadow:none;}
  .btn-add:not(:disabled):active{transform:scale(.98);}

  .btn-outline{
    background:var(--paper);
    color:var(--coke-red);
    border:1.5px solid var(--line-strong);
  }
  .btn-outline:active{background:var(--paper-wash);}

  .item{
    background:var(--paper);
    border:1px solid var(--line);
    border-radius:var(--radius-md);
    padding:11px 13px;
    margin-bottom:9px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:8px;
    box-shadow:var(--shadow-sm);
    transition:transform .15s ease, border-color .15s ease;
  }
  .item:hover{border-color:var(--coke-red);transform:translateY(-1px);}
  .item .info{font-size:13.5px;}
  .item .info b{display:block;font-size:13.5px;margin-bottom:2px;color:var(--ink);}
  .item .info span{color:var(--muted);font-size:12px;}
  .item .info .validade-warn{color:var(--danger);font-weight:700;}

  .del-btn{
    background:transparent;
    color:var(--danger);
    border:1.5px solid var(--danger);
    padding:7px 11px;
    font-size:12px;
    border-radius:var(--radius-sm);
    flex-shrink:0;
  }
  .del-btn:active{background:rgba(214,36,44,.08);}

  .empty-msg{
    text-align:center;
    color:var(--muted);
    font-size:13px;
    padding:20px 0;
  }

  .footer-bar{
    position:fixed;
    bottom:0;left:0;right:0;
    background:var(--paper);
    border-top:1px solid var(--line);
    padding:10px 14px calc(10px + env(safe-area-inset-bottom));
    display:flex;
    gap:10px;
    z-index:30;
    box-shadow:0 -8px 24px rgba(26,20,20,.06);
  }
  .footer-bar button{flex:1;font-size:13px;padding:12px 8px;font-family:'Inter',sans-serif;}
  .btn-share{background:#128A3E;color:#fff;}
  .btn-copy{background:var(--surface);color:var(--ink);border:1.5px solid var(--line-strong);}
  .btn-pdf{background:var(--ink);color:#fff;}

  .counter{
    font-size:12px;
    font-weight:600;
    color:var(--muted);
    text-align:right;
    margin-bottom:8px;
    background:var(--surface);
    border-radius:8px;
    padding:7px 10px;
  }

  .loja-atual-tag{
    font:700 11px 'Inter',sans-serif;
    color:var(--coke-red);
    background:var(--paper-wash);
    display:inline-block;
    padding:5px 11px;
    border-radius:999px;
    margin-bottom:10px;
  }

  .lojas-hint{
    margin:0 0 12px;
    font-size:12px;
    line-height:1.5;
    color:var(--muted);
  }

  .loja-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:8px;
    padding:11px 12px;
    border:1.5px solid var(--line);
    border-radius:var(--radius-md);
    margin-bottom:8px;
    background:var(--paper);
    transition:border-color .15s ease;
  }
  .loja-row.ativa{
    border-color:var(--coke-red);
    background:var(--paper-wash);
  }
  .loja-info b{display:block;font-size:13.5px;color:var(--ink);margin-bottom:1px;}
  .loja-info span{font-size:11.5px;color:var(--muted);}
  .loja-actions{display:flex;gap:6px;flex-shrink:0;}
  .btn-mini{
    padding:8px 11px;
    font-size:11.5px;
    border-radius:8px;
    font-weight:700;
  }
  .btn-mini-outline{background:var(--paper);color:var(--ink-soft);border:1.5px solid var(--line-strong);}
  .btn-mini-outline:active{background:var(--surface);}
  .btn-mini-pdf{background:var(--ink);color:#fff;}
  .btn-mini-pdf:active{opacity:.85;}
  .btn-mini-del{background:transparent;color:var(--danger);border:1.5px solid var(--danger);padding:8px 10px;}
  .btn-mini-del:active{background:rgba(214,36,44,.08);}

  .toast{
    position:fixed;
    bottom:84px;left:50%;
    transform:translateX(-50%);
    background:var(--ink);
    color:#fff;
    padding:11px 20px;
    border-radius:999px;
    font-size:13px;
    box-shadow:0 10px 28px rgba(0,0,0,.28);
    z-index:150;
    opacity:0;
    pointer-events:none;
    transition:opacity .25s;
  }
  .toast.show{opacity:1;}

  .scanner-modal{
    display:none;
    position:fixed;
    top:0;left:0;right:0;bottom:0;
    background:rgba(20,10,10,.92);
    z-index:100;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    padding:16px;
  }
  .scanner-box{
    width:100%;
    max-width:420px;
    background:#000;
    border-radius:var(--radius-lg);
    overflow:hidden;
    border:2px solid var(--coke-red);
  }
  #reader{width:100%;}
  #reader video{width:100% !important;border-radius:calc(var(--radius-lg) - 2px) calc(var(--radius-lg) - 2px) 0 0;}
  .scanner-hint{
    text-align:center;
    color:#ddd;
    font-size:12.5px;
    padding:12px 14px;
    background:#111;
  }
  .scanner-hint strong{color:#fff;}
  .scanner-hint span{display:block;margin-top:4px;color:#bbb;line-height:1.45;}
  .btn-close-scanner{
    width:100%;
    max-width:420px;
    margin-top:12px;
    background:rgba(255,255,255,.08);
    color:#fff;
    border:1.5px solid rgba(255,255,255,.18);
  }

  .scan-status{
    display:flex;
    align-items:center;
    gap:8px;
    margin-top:10px;
    font-size:11.5px;
    color:var(--muted);
  }
  .scan-dot{
    width:8px;height:8px;border-radius:50%;
    background:#ccc;
    box-shadow:0 0 0 3px rgba(0,0,0,.03);
  }
  .scan-dot.ok{background:var(--success);box-shadow:0 0 0 4px rgba(15,138,62,.15);}

  /* ===== TOP NAV (segmented pills) ===== */
  .top-menu{
    display:flex;
    gap:7px;
    overflow-x:auto;
    padding:14px 0 16px;
    scrollbar-width:none;
  }
  .top-menu::-webkit-scrollbar{display:none;}

  .menu-btn{
    flex:0 0 auto;
    border:1.5px solid var(--line-strong) !important;
    background:var(--paper) !important;
    color:var(--ink-soft) !important;
    padding:9px 15px !important;
    min-height:40px;
    font-size:12.5px !important;
    font-family:'Barlow Condensed',sans-serif;
    font-weight:700 !important;
    text-transform:uppercase;
    letter-spacing:.4px;
    border-radius:999px !important;
    box-shadow:none;
  }
  .menu-btn.active{
    background:linear-gradient(135deg,var(--coke-red),var(--coke-red-deep)) !important;
    color:#fff !important;
    border-color:transparent !important;
    box-shadow:var(--shadow-red);
  }

  .app-section{display:none;}
  .app-section.active{display:block;}

  /* ===== CHECKLIST ===== */
  .checklist-head{
    background:linear-gradient(135deg,var(--coke-red),var(--coke-red-deep));
    color:#fff;
    border-radius:var(--radius-lg);
    padding:16px 18px;
    margin-bottom:14px;
    box-shadow:var(--shadow-red);
  }
  .checklist-head h2{
    margin:0 0 4px;
    font-family:'Barlow Condensed',sans-serif;
    font-weight:800;
    font-size:21px;
    text-transform:uppercase;
    letter-spacing:.3px;
  }
  .checklist-head p{
    margin:0;
    font:500 12.5px/1.4 'Inter',sans-serif;
    color:rgba(255,255,255,.85);
  }

  .market-types{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:8px;
    margin:0 0 14px;
  }
  .market-type{
    border:1.5px solid var(--line-strong) !important;
    background:var(--paper) !important;
    color:var(--ink-soft) !important;
    padding:12px 6px !important;
    min-height:62px;
    font-size:11.5px !important;
    font-family:'Inter',sans-serif;
    font-weight:700;
    line-height:1.2;
    border-radius:var(--radius-md) !important;
    box-shadow:var(--shadow-sm);
  }
  .market-type.active{
    background:linear-gradient(135deg,var(--coke-red),var(--coke-red-deep)) !important;
    color:#fff !important;
    border-color:transparent !important;
    box-shadow:var(--shadow-red);
  }
  .market-type small{
    display:block;
    margin-top:4px;
    font-size:9.5px;
    font-weight:500;
    opacity:.8;
  }

  .check-progress{
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:999px;
    height:14px;
    overflow:hidden;
    margin:4px 0 6px;
  }
  .check-progress-bar{
    height:100%;
    width:0%;
    background:linear-gradient(90deg,var(--coke-red-2),var(--coke-red));
    border-radius:999px;
    transition:width .3s ease;
  }
  .check-progress-text{
    text-align:right;
    font:700 11px 'Inter',sans-serif;
    color:var(--muted);
  }

  .check-group{
    margin-top:14px;
    border:1px solid var(--line);
    border-radius:var(--radius-md);
    overflow:hidden;
    background:var(--paper);
  }
  .check-group-title{
    margin:0;
    padding:10px 13px;
    background:var(--paper-wash);
    color:var(--coke-red-deep);
    font:800 11.5px 'Barlow Condensed',sans-serif;
    text-transform:uppercase;
    letter-spacing:.5px;
    border-bottom:1px solid var(--line);
    display:flex;
    align-items:center;
    justify-content:space-between;
  }
  .group-pts{
    font:700 10.5px 'Inter',sans-serif;
    color:var(--coke-red);
  }

  .check-item{
    display:flex;
    align-items:flex-start;
    gap:11px;
    padding:12px 13px;
    border-bottom:1px solid var(--line);
    cursor:pointer;
  }
  .check-item:last-child{border-bottom:0;}

  .check-item input[type=checkbox]{
    appearance:none;
    -webkit-appearance:none;
    flex:0 0 auto;
    width:23px;
    height:23px;
    margin:1px 0 0;
    padding:0;
    border:2px solid var(--line-strong);
    border-radius:7px;
    background:#fff;
    display:grid;
    place-content:center;
    transition:background .15s ease, border-color .15s ease;
  }
  .check-item input[type=checkbox]:checked{
    background:var(--coke-red);
    border-color:var(--coke-red);
  }
  .check-item input[type=checkbox]:checked:after{
    content:"";
    width:6px;height:11px;
    border:solid #fff;
    border-width:0 2.5px 2.5px 0;
    transform:rotate(40deg) translate(-1px,-1px);
  }

  .check-label{
    flex:1;
    font:500 13.5px/1.4 'Inter',sans-serif;
    color:var(--ink);
  }
  .check-label small{
    display:block;
    color:var(--muted);
    margin-top:3px;
    font-size:11px;
    font-weight:400;
  }

  .pts-badge{
    display:inline-block;
    background:var(--coke-red);
    color:#fff;
    font:800 10px 'Barlow Condensed',sans-serif;
    letter-spacing:.3px;
    padding:2px 8px;
    border-radius:999px;
    margin-left:4px;
    white-space:nowrap;
    vertical-align:middle;
  }

  .cod-badge{
    display:inline-block;
    background:var(--surface);
    color:var(--muted);
    border:1px solid var(--line-strong);
    font:700 9.5px 'Inter',monospace;
    letter-spacing:.2px;
    padding:1px 6px;
    border-radius:6px;
    margin-right:6px;
    white-space:nowrap;
    vertical-align:middle;
  }

  .check-actions{
    display:flex;
    gap:8px;
    margin-top:14px;
  }
  .check-actions button{flex:1;min-height:44px;}

  .activation-note{
    margin-top:14px;
    padding:11px 13px;
    background:var(--paper-wash);
    border:1px dashed var(--line-strong);
    border-radius:var(--radius-sm);
    color:var(--ink-soft);
    font:12px/1.5 'Inter',sans-serif;
  }

  @media (max-width:380px){
    .market-types{grid-template-columns:1fr 1fr 1fr;gap:6px;}
    .market-type{font-size:10.5px !important;padding:10px 4px !important;}
  }

  @media (min-width:700px){
    .container{max-width:680px;}
    .header-inner{max-width:680px;}
    header h1{font-size:26px;}
  }

  .product-search{display:flex;gap:8px;margin-bottom:12px}.product-search input{flex:1}.product-count{font-size:12px;color:var(--muted);margin:0 0 10px}.product-list{display:flex;flex-direction:column;gap:8px;max-height:520px;overflow:auto}.product-row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--paper)}.product-row b{display:block;font-size:13px;line-height:1.25}.product-row span{display:block;font-size:11px;color:var(--muted);margin-top:3px}.history-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}.history-stat{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-md);padding:11px 8px;text-align:center}.history-stat strong{display:block;font:800 20px 'Barlow Condensed',sans-serif;color:var(--coke-red)}.history-stat span{font-size:10px;color:var(--muted)}.history-row{border:1px solid var(--line);border-radius:var(--radius-md);padding:12px;margin-bottom:8px;background:var(--paper)}.history-row h3{margin:0 0 4px;font-size:14px}.history-row .meta{font-size:11px;color:var(--muted);line-height:1.5}.history-actions{display:flex;gap:6px;margin-top:9px}.history-actions button{flex:1;padding:8px 9px;font-size:11px}.form-note{font-size:11px;color:var(--muted);line-height:1.45;margin-top:8px}

/* ===== LOGIN / CONTA ONLINE ===== */
.auth-gate{position:fixed;inset:0;z-index:500;background:linear-gradient(160deg,#f40009 0%,#8a0000 100%);display:flex;align-items:center;justify-content:center;padding:20px;overflow:auto}
.auth-card{width:100%;max-width:430px;background:#fff;border-radius:24px;padding:24px;box-shadow:0 24px 60px rgba(0,0,0,.28)}
