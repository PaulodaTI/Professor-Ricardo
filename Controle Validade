async function cloudDeleteVisit(chave){ if(sb&&cloudUser) await sb.from('visits').delete().eq('user_id',cloudUser.id).eq('chave',chave); }
async function cloudSaveChecklist(){
  if(!sb||!cloudUser)return;
  const dados={}; document.querySelectorAll('#checklistItems input[type=checkbox]').forEach(i=>dados[i.dataset.key]=i.checked);
  await sb.from('checklists').upsert({user_id:cloudUser.id,mercado:mercadoAtual,dados},{onConflict:'user_id,mercado'});
}
async function cloudDeleteChecklist(){ if(sb&&cloudUser) await sb.from('checklists').delete().eq('user_id',cloudUser.id).eq('mercado',mercadoAtual); }

function instalarCloudOverrides(){
  const oldSaveProducts=window.salvarProdutosCustom;
  const oldSaveVisits=window.salvarLojasData;
  const oldDeleteVisit=window.excluirLoja;
  window.salvarProdutosCustom=function(){ try{localStorage.setItem('controleValidade_produtosCustom',JSON.stringify(produtosCustom));}catch(e){} cloudSaveProducts().catch(console.error); };
  window.salvarLojasData=function(){ try{localStorage.setItem('controleValidade_lojas',JSON.stringify(lojasData));}catch(e){} cloudSaveVisits().catch(console.error); };
  window.excluirLoja=oldDeleteVisit;
}

async function authBootstrap(){
  if(!CLOUD_CONFIGURED){
    document.getElementById('authGate').style.display='flex';
    authMsg('Configure SUPABASE_URL e SUPABASE_ANON_KEY no arquivo antes de publicar.',true);
    document.getElementById('authSubmit').disabled=true;
    return;
  }
  if(!window.supabase){authMsg('Biblioteca Supabase não carregou. Verifique a internet.',true);return;}
  sb=window.supabase.createClient(SUPABASE_URL,SUPABASE_ANON_KEY,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});
  const {data}=await sb.auth.getSession();
  if(data.session) await onSignedIn(data.session.user); else document.getElementById('authGate').style.display='flex';
  sb.auth.onAuthStateChange(async(_event,session)=>{ if(session) await onSignedIn(session.user); else onSignedOut(); });
}
async function onSignedIn(user){
  cloudUser=user;
  document.getElementById('authGate').style.display='none';
  document.getElementById('authUserbar').style.display='block';
  document.getElementById('authUserEmail').textContent=user.email||'';
  instalarCloudOverrides();
  await cloudLoad();
}
function onSignedOut(){ cloudUser=null;document.getElementById('authUserbar').style.display='none';document.getElementById('authGate').style.display='flex';setAuthMode('login'); }

document.getElementById('authSubmit').addEventListener('click',async()=>{
  if(!sb)return; const email=document.getElementById('authEmail').value.trim(), password=document.getElementById('authPassword').value, nome=document.getElementById('authName').value.trim(), telefone=document.getElementById('authPhone').value.trim();
  if(!email||!password)return authMsg('Informe e-mail e senha.');
  setAuthLoading(true);authMsg('');
  try{
    if(authMode==='signup'){
      if(password.length<6)return authMsg('A senha precisa ter pelo menos 6 caracteres.');
      const {data,error}=await sb.auth.signUp({email,password,options:{data:{nome,telefone}}}); if(error)throw error;
      if(data.session) await onSignedIn(data.user); else authMsg('Conta criada. Verifique seu e-mail para confirmar o cadastro.',false);
    }else{ const {data,error}=await sb.auth.signInWithPassword({email,password}); if(error)throw error; await onSignedIn(data.user); }
  }catch(e){authMsg(e.message||'Não foi possível concluir a operação.');}
  finally{setAuthLoading(false);}
});
document.getElementById('authToggle').addEventListener('click',()=>setAuthMode(authMode==='login'?'signup':'login'));
document.getElementById('authForgot').addEventListener('click',async()=>{
  if(!sb)return;const email=document.getElementById('authEmail').value.trim();if(!email)return authMsg('Digite seu e-mail primeiro.');
  const {error}=await sb.auth.resetPasswordForEmail(email,{redirectTo:location.origin+location.pathname}); if(error)authMsg(error.message);else authMsg('Link de recuperação enviado para seu e-mail.',false);
});
document.getElementById('authLogout').addEventListener('click',async()=>{if(sb)await sb.auth.signOut();});

// Sobrescreve o salvamento de checklist para também ir à nuvem.
const _salvarChecklistOriginal=window.salvarChecklist;
window.salvarChecklist=async function(){ if(typeof _salvarChecklistOriginal==='function')_salvarChecklistOriginal(); await cloudSaveChecklist(); };
const _limparChecklistOriginal=window.limparChecklist;
window.limparChecklist=async function(){ if(typeof _limparChecklistOriginal==='function')_limparChecklistOriginal(); await cloudDeleteChecklist(); };

window.addEventListener('DOMContentLoaded',authBootstrap);
