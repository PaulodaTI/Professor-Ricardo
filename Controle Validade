function processarCodigoEscaneado(codigo){
  codigo = codigo.trim();
  // tenta achar exato, ou ignorando zeros à esquerda
  let produto = PRODUTOS.find(p => p.codigo === codigo);
  if(!produto){
    const semZeros = codigo.replace(/^0+/, '');
    produto = PRODUTOS.find(p => p.codigo.replace(/^0+/, '') === semZeros);
  }
  if(produto){
    selecionarProduto(produto);
    beepLeitura();
    atualizarStatus('Produto lido com sucesso: ' + produto.descricao, true);
    showToast('🔊 Beep! ' + produto.descricao);
    validadeInput.focus();
  } else {
    buscaInput.value = codigo;
    renderSuggestions(codigo);
    atualizarStatus('Código não cadastrado. Cadastre o produto na aba Produtos.', false);
    showToast('⚠️ Código não cadastrado. Abrindo cadastro...');
    fecharScanner();
    setTimeout(()=>{ const b=document.querySelector('.menu-btn[onclick*="produtos"]'); abrirSecao('produtos',b); abrirCadastroProduto(codigo); },120);
  }
}

function isCameraSupported(){
  return !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia);
}

// Atualiza o indicador de status do leitor (bolinha + texto acima do formulário de busca).
function atualizarStatus(msg, ok=false){
  const text = document.getElementById('scanStatusText');
  const dot = document.getElementById('scanDot');
  if(text) text.textContent = msg || '';
  if(dot) dot.classList.toggle('ok', !!ok);
}

// Bipe curto ao reconhecer um código de barras (Web Audio API, sem depender de arquivo de áudio).
function beepLeitura(){
  try{
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.value = 1500;
    gain.gain.setValueAtTime(0.001, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.2, ctx.currentTime + 0.01);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.15);
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start();
    osc.stop(ctx.currentTime + 0.16);
    osc.onended = () => ctx.close();
  }catch(e){ /* som indisponível neste navegador, segue sem travar o app */ }
}

function atualizarStatusScanner(msg, ok=false){
  atualizarStatus(msg, ok);
  const hint = document.getElementById('scannerEnvironmentHint');
  if(hint){
    if(window.isSecureContext){
      hint.textContent = 'Site seguro (HTTPS): a câmera pode ser usada após você autorizar o acesso.';
    }else{
      hint.textContent = 'A câmera do celular exige HTTPS. Publique este arquivo em Netlify, GitHub Pages ou outra hospedagem HTTPS.';
    }
  }
}

async function abrirScanner(){
  if(typeof Html5Qrcode === 'undefined'){
    showToast('Leitor de código não carregou. Verifique sua internet e recarregue a página.');
    atualizarStatusScanner('Biblioteca da câmera não carregada.', false);
    return;
  }

  if(!window.isSecureContext && location.hostname !== 'localhost' && location.hostname !== '127.0.0.1'){
    showToast('A câmera precisa de HTTPS. Abra a versão publicada do site.');
    atualizarStatusScanner('Câmera bloqueada: este endereço não é HTTPS.', false);
    return;
  }

  if(!isCameraSupported()){
    showToast('Seu navegador não disponibilizou acesso à câmera.');
    atualizarStatusScanner('Câmera não suportada neste navegador.', false);
    return;
  }

  const modal = document.getElementById('scannerModal');
  modal.style.display = 'flex';
  scannerAtivo = true;
  atualizarStatusScanner('Solicitando acesso à câmera...');

  try{
    if(html5QrCode){
      try{ await html5QrCode.stop(); }catch(e){}
      try{ html5QrCode.clear(); }catch(e){}
    }
    html5QrCode = new Html5Qrcode('reader');

    const config = {
      fps: 12,
      qrbox: { width: 280, height: 150 },
      aspectRatio: 1.777778,
      formatsToSupport: [
        Html5QrcodeSupportedFormats.EAN_13,
        Html5QrcodeSupportedFormats.EAN_8,
        Html5QrcodeSupportedFormats.UPC_A,
        Html5QrcodeSupportedFormats.UPC_E,
        Html5QrcodeSupportedFormats.CODE_128,
        Html5QrcodeSupportedFormats.CODE_39
      ],
      rememberLastUsedCamera: true,
      showTorchButtonIfSupported: true,
      showZoomSliderIfSupported: true,
      // Pede foco automático contínuo, ajuda a focar em códigos próximos/manuseados na mão.
      focusMode: 'continuous',
      videoConstraints: { advanced: [{ focusMode: 'continuous' }] }
    };

    // Busca a lista de câmeras só para popular o botão de troca (nomes/rótulos).
    let cameras = [];
    try{ cameras = await Html5Qrcode.getCameras(); }catch(e){ cameras = []; }

    if(!cameras.length){
      throw new Error('Nenhuma câmera encontrada ou permissão negada.');
    }

    let deviceIdConfirmadoFrontal = null;
    try{
      // Pede a câmera frontal diretamente ao navegador (mais confiável do que adivinhar
      // pelo nome/rótulo da câmera, que em muitos aparelhos vem genérico tipo "Camera 1").
      await html5QrCode.start(
        { facingMode: { exact: 'user' } },
        config,
        (decodedText) => {
          if(!scannerAtivo) return;
          scannerAtivo = false;
          processarCodigoEscaneado(decodedText);
          pararScannerSemEsperar();
        },
        () => {}
      );
      const settings = html5QrCode.getRunningTrackSettings ? html5QrCode.getRunningTrackSettings() : null;
      deviceIdConfirmadoFrontal = settings && settings.deviceId;
    }catch(eFacing){
      // Aparelho/navegador não aceitou facingMode exato: volta para o método antigo por id de câmera.
      deviceIdConfirmadoFrontal = null;
    }

    // Câmeras candidatas para o botão de troca: mantém só as marcadas como frontal/selfie (se houver mais de uma).
    let candidatas = cameras.filter(c => /front|user|frontal|selfie/i.test(c.label || ''));
    if(!candidatas.length) candidatas = cameras;

    if(deviceIdConfirmadoFrontal){
      // Garante que a câmera que o navegador confirmou ser frontal fique em primeiro na lista.
      candidatas = candidatas.filter(c => c.id !== deviceIdConfirmadoFrontal);
      const infoOriginal = cameras.find(c => c.id === deviceIdConfirmadoFrontal);
      candidatas.unshift({ id: deviceIdConfirmadoFrontal, label: (infoOriginal && infoOriginal.label) || 'Câmera frontal' });
    }

    camerasDisponiveis = candidatas;
    cameraAtualIndex = 0;

    const btnFlip = document.getElementById('btnFlipCamera');
    if(btnFlip) btnFlip.style.display = camerasDisponiveis.length > 1 ? 'block' : 'none';

    if(!deviceIdConfirmadoFrontal){
      // Fallback: facingMode exato falhou, inicia manualmente por id de câmera como antes.
      await iniciarStreamCamera(cameraAtualIndex, config);
    }else{
      const numeroLente = 1;
      atualizarStatusScanner('Lente ' + numeroLente + ' de ' + camerasDisponiveis.length + ' (frontal) ativa: aponte para o código de barras.', true);
    }
  }catch(err){
    console.error('Erro ao iniciar câmera:', err);
    let msg = 'Não foi possível acessar a câmera.';
    if(/permission|notallowed|denied/i.test(String(err))) msg = 'Permissão da câmera negada. Autorize a câmera nas configurações do navegador.';
    else if(/https|secure|insecure/i.test(String(err))) msg = 'A câmera exige HTTPS.';
    showToast(msg);
    atualizarStatusScanner(msg, false);
  }
}

async function iniciarStreamCamera(index, config){
  const camera = camerasDisponiveis[index];
  if(!camera) throw new Error('Câmera indisponível.');

  await html5QrCode.start(
    camera.id,
    config,
    (decodedText) => {
      if(!scannerAtivo) return;
      scannerAtivo = false;
      processarCodigoEscaneado(decodedText);
      pararScannerSemEsperar();
    },
    () => {}
  );

  // Reforça o foco automático contínuo diretamente na track já em execução
  // (alguns navegadores só aceitam esse ajuste depois que a câmera já está ativa).
  try{
    if(typeof html5QrCode.applyVideoConstraints === 'function'){
      await html5QrCode.applyVideoConstraints({ advanced: [{ focusMode: 'continuous' }] });
    }
  }catch(e){ /* navegador/aparelho não suporta ajuste manual de foco, segue com o padrão */ }

  const numeroLente = camerasDisponiveis.indexOf(camera) + 1;
  atualizarStatusScanner('Lente ' + numeroLente + ' de ' + camerasDisponiveis.length + ' ativa: aponte para o código de barras.', true);
}

async function alternarCamera(){
  if(!html5QrCode || camerasDisponiveis.length < 2) return;
  const config = {
    fps: 12,
    qrbox: { width: 280, height: 150 },
    aspectRatio: 1.777778,
    formatsToSupport: [
      Html5QrcodeSupportedFormats.EAN_13,
      Html5QrcodeSupportedFormats.EAN_8,
      Html5QrcodeSupportedFormats.UPC_A,
      Html5QrcodeSupportedFormats.UPC_E,
      Html5QrcodeSupportedFormats.CODE_128,
      Html5QrcodeSupportedFormats.CODE_39
    ],
    rememberLastUsedCamera: true,
    showTorchButtonIfSupported: true,
    showZoomSliderIfSupported: true,
    focusMode: 'continuous',
    videoConstraints: { advanced: [{ focusMode: 'continuous' }] }
  };
  try{
    atualizarStatusScanner('Trocando de câmera...');
    try{ await html5QrCode.stop(); }catch(e){}
    cameraAtualIndex = (cameraAtualIndex + 1) % camerasDisponiveis.length;
    scannerAtivo = true;
    await iniciarStreamCamera(cameraAtualIndex, config);
  }catch(err){
    console.error('Erro ao trocar de câmera:', err);
    showToast('Não foi possível trocar de câmera.');
    atualizarStatusScanner('Não foi possível trocar de câmera.', false);
  }
}

function pararScannerSemEsperar(){
  const scanner = html5QrCode;
