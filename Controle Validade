    inputs.forEach(i => {
      const pts = parseFloat(i.dataset.pts) || 0;
      totalPts += pts;
      if(i.checked) feitosPts += pts;
    });
    const pct = totalPts ? Math.round((feitosPts / totalPts) * 100) : 0;

    const bar = document.getElementById('checkProgressBar');
    const text = document.getElementById('checkProgressText');
    if(bar) bar.style.width = pct + '%';
    if(text) text.textContent = pct + '% concluído (' + formatPts(feitosPts) + '/' + formatPts(totalPts) + ' pts)';
  }

