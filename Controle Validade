function normaliza(str){
  return str.toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
}

function renderSuggestions(query){
  const q = normaliza(query);
  if(!q){ suggestionsBox.style.display='none'; suggestionsBox.innerHTML=''; return; }
  const matches = PRODUTOS.filter(p => normaliza(p.descricao).includes(q) || p.codigo.includes(query)).slice(0,30);
  if(matches.length===0){
    suggestionsBox.innerHTML = '<div style="color:var(--muted);cursor:default;">Nenhum produto encontrado</div>';
    suggestionsBox.style.display='block';
    return;
  }
  suggestionsBox.innerHTML = matches.map((p,i) =>
