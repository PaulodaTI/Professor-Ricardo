let lojasData = {};
let lojaAtualChave = '';
let selecionado = null;
let produtosCustom = [];

function carregarProdutosCustom(){
  try{ produtosCustom=JSON.parse(localStorage.getItem('controleValidade_produtosCustom')||'[]'); }catch(e){ produtosCustom=[]; }
  if(!Array.isArray(produtosCustom)) produtosCustom=[];
  const mapa=new Map(PRODUTOS.map(p=>[String(p.codigo),p]));
  produtosCustom.forEach(p=>{if(p&&p.descricao&&p.codigo) mapa.set(String(p.codigo),p)});
  PRODUTOS=Array.from(mapa.values());
}
function salvarProdutosCustom(){try{localStorage.setItem('controleValidade_produtosCustom',JSON.stringify(produtosCustom))}catch(e){}}
carregarProdutosCustom();

function carregarLojasData(){
  try{
    const raw = localStorage.getItem('controleValidade_lojas');
    lojasData = raw ? JSON.parse(raw) : {};
  }catch(e){
    lojasData = {};
  }
}

function salvarLojasData(){
  try{
    localStorage.setItem('controleValidade_lojas', JSON.stringify(lojasData));
  }catch(e){ /* armazenamento indisponível, segue apenas em memória */ }
}

function chaveDaLoja(nome){
  const n = (nome || '').trim();
  return n ? normaliza(n) : '_sem_loja';
}

// Garante que a loja atualmente digitada tenha um registro próprio,
// separando seus itens de qualquer outra loja já catalogada.
function garantirLojaAtual(){
  const nomeDigitado = document.getElementById('loja').value;
  const chave = chaveDaLoja(nomeDigitado);
  if(!lojasData[chave]){
    lojasData[chave] = {
      nomeLoja: nomeDigitado.trim() || 'Loja não informada',
      promotor: document.getElementById('promotor').value,
      dataLevantamento: document.getElementById('dataLevantamento').value,
      itens: []
    };
  } else {
    lojasData[chave].nomeLoja = nomeDigitado.trim() || lojasData[chave].nomeLoja;
    lojasData[chave].promotor = document.getElementById('promotor').value;
    lojasData[chave].dataLevantamento = document.getElementById('dataLevantamento').value;
  }
  lojaAtualChave = chave;
  salvarLojasData();
}

function itensAtuais(){
  return (lojasData[lojaAtualChave] && lojasData[lojaAtualChave].itens) || [];
}

function abrirLoja(chave){
  const l = lojasData[chave];
  if(!l) return;
  lojaAtualChave = chave;
  document.getElementById('loja').value = l.nomeLoja;
  document.getElementById('promotor').value = l.promotor || '';
  if(l.dataLevantamento) document.getElementById('dataLevantamento').value = l.dataLevantamento;
  renderLista();
  renderLojasCatalogadas();
  showToast('Loja aberta: ' + l.nomeLoja);
  window.scrollTo({top:0, behavior:'smooth'});
}

function excluirLoja(chave){
  const l = lojasData[chave];
  if(!l) return;
  if(!confirm(`Excluir todos os itens de "${l.nomeLoja}"? Essa ação não pode ser desfeita.`)) return;
  delete lojasData[chave];
  if(lojaAtualChave === chave){
    lojaAtualChave = '';
    document.getElementById('loja').value = '';
  }
  salvarLojasData();
  renderLista();
  renderLojasCatalogadas();
  renderHistorico();
  showToast('Loja removida.');
}

function renderLojasCatalogadas(){
  const card = document.getElementById('lojasCard');
  const cont = document.getElementById('listaLojas');
  const chaves = Object.keys(lojasData).filter(ch => lojasData[ch].itens.length > 0 || ch === lojaAtualChave);
  if(chaves.length === 0){
    card.style.display = 'none';
    return;
  }
  card.style.display = 'block';
  cont.innerHTML = chaves.map(ch => {
    const l = lojasData[ch];
    const ativa = ch === lojaAtualChave;
    return `<div class="loja-row ${ativa ? 'ativa' : ''}">
      <div class="loja-info">
        <b>${l.nomeLoja}</b>
        <span>${l.itens.length} ${l.itens.length===1 ? 'item' : 'itens'}${ativa ? ' · em edição' : ''}</span>
      </div>
      <div class="loja-actions">
        <button type="button" class="btn-mini btn-mini-outline" data-abrir="${ch}">Abrir</button>
        <button type="button" class="btn-mini btn-mini-pdf" data-pdf="${ch}">PDF</button>
        <button type="button" class="btn-mini btn-mini-del" data-del="${ch}" aria-label="Excluir loja">✕</button>
      </div>
    </div>`;
  }).join('');
}

document.getElementById('listaLojas').addEventListener('click', (e) => {
  const abrirBtn = e.target.closest('[data-abrir]');
  const pdfBtn = e.target.closest('[data-pdf]');
  const delBtn = e.target.closest('[data-del]');
  if(abrirBtn) abrirLoja(abrirBtn.dataset.abrir);
  else if(pdfBtn) gerarPDF(pdfBtn.dataset.pdf);
  else if(delBtn) excluirLoja(delBtn.dataset.del);
});

document.getElementById('loja').addEventListener('change', () => {
  garantirLojaAtual();
  renderLista();
  renderLojasCatalogadas();
});

document.getElementById('promotor').addEventListener('change', () => {
  if(lojasData[lojaAtualChave]){
    lojasData[lojaAtualChave].promotor = document.getElementById('promotor').value;
    salvarLojasData();
  }
});

document.getElementById('dataLevantamento').addEventListener('change', () => {
  if(lojasData[lojaAtualChave]){
    lojasData[lojaAtualChave].dataLevantamento = document.getElementById('dataLevantamento').value;
    salvarLojasData();
  }
});

