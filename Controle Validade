function formatDate(iso){
  if(!iso) return '';
  const [y,m,d] = iso.split('-');
  return `${d}/${m}/${y}`;
}

function diasParaVencer(iso){
  const hoje = new Date();
  hoje.setHours(0,0,0,0);
  const venc = new Date(iso + 'T00:00:00');
  return Math.round((venc - hoje) / 86400000);
}

