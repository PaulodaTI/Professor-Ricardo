function sanitizeFilename(str){
  return (str || 'loja').toString()
    .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
    .replace(/[^a-zA-Z0-9]+/g,'_')
    .replace(/^_+|_+$/g,'')
    .slice(0,40) || 'loja';
}

async function gerarPDF(chave){
  const ch = chave || lojaAtualChave;
  const dados = lojasData[ch];
  if(!dados || dados.itens.length === 0){
    showToast('Essa loja ainda não tem itens cadastrados.');
    return;
  }

  if(!window.jspdf || typeof window.jspdf.jsPDF !== 'function'){
    showToast('Biblioteca do PDF não carregou. Verifique a internet e recarregue a página.');
    console.error('jsPDF indisponível:', window.jspdf);
    return;
  }

  const itensLoja = dados.itens;
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ unit: 'pt', format: 'a4' });
  const pageWidth = doc.internal.pageSize.getWidth();

  const promotor = dados.promotor || '(não informado)';
  const loja = dados.nomeLoja || '(não informado)';
  const dataLevIso = dados.dataLevantamento;
  const dataLev = dataLevIso ? formatDate(dataLevIso) : '(não informado)';

  // Cabecalho vermelho
  doc.setFillColor(244, 0, 9);
  doc.rect(0, 0, pageWidth, 60, 'F');
  doc.setTextColor(255, 255, 255);
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(16);
  doc.text('CONTROLE DE VALIDADE', 40, 36);
  doc.setFontSize(9);
  doc.setFont('helvetica', 'normal');
  doc.text('Coca-Cola · Levantamento de campo', 40, 50);

  // Dados da visita
  doc.setTextColor(30, 30, 30);
  doc.setFontSize(10);
  doc.setFont('helvetica', 'bold');
  let y = 84;
  doc.text('Promotor:', 40, y);
  doc.text('Loja:', 230, y);
  doc.text('Data do levantamento:', 400, y);
  doc.setFont('helvetica', 'normal');
  doc.text(promotor, 88, y);
  doc.text(loja, 252, y);
  doc.text(dataLev, 490, y);

  // Linha separadora
  doc.setDrawColor(220, 220, 220);
  doc.line(40, y + 12, pageWidth - 40, y + 12);

  const rows = itensLoja.map((it, i) => {
    const dias = diasParaVencer(it.validade);
    const statusTxt = dias < 0 ? `Vencido há ${Math.abs(dias)}d` : (dias <= 7 ? `${dias}d p/ vencer` : `${dias}d`);
    return [String(i+1), it.descricao, it.codigo, formatDate(it.validade), String(it.quantidade), statusTxt];
  });

  if(typeof doc.autoTable === 'function'){
    doc.autoTable({
      startY: y + 24,
      head: [['#', 'Descrição', 'Código', 'Validade', 'Qtd', 'Status']],
      body: rows,
      styles: { fontSize: 8.5, cellPadding: 5, valign: 'middle' },
      headStyles: { fillColor: [244, 0, 9], textColor: 255, fontStyle: 'bold' },
      alternateRowStyles: { fillColor: [247, 247, 247] },
      columnStyles: {
        0: { cellWidth: 24, halign: 'center' },
        1: { cellWidth: 210 },
        2: { cellWidth: 80 },
        3: { cellWidth: 65, halign: 'center' },
        4: { cellWidth: 40, halign: 'center' },
        5: { cellWidth: 80, halign: 'center' }
      },
      didParseCell: function(data){
        if(data.section === 'body'){
          const it = itensLoja[data.row.index];
          const dias = diasParaVencer(it.validade);
          if(dias <= 7){
            data.cell.styles.textColor = [200, 30, 30];
            if(data.column.index === 3 || data.column.index === 5){
